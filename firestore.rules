rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myHousehold() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    function inHouse(hid) {
      return userExists() && hid is string && hid == myHousehold();
    }

    function unchanged(field) {
      return !(field in resource.data) || request.resource.data[field] == resource.data[field];
    }

    function keepOwnerFields() {
      return unchanged('userId')
        && unchanged('profileId')
        && unchanged('householdId')
        && unchanged('ownerUserId')
        && unchanged('createdBy');
    }

    function appCollection(col) {
      return col in [
        'profiles',
        'exercises',
        'workoutTemplates',
        'workoutTemplateExercises',
        'workoutSessions',
        'workoutSessionExercises',
        'exerciseSets',
        'personalRecords',
        'dietPlans',
        'dietMeals',
        'dietMealItems',
        'dietSupplements',
        'foods',
        'foodLogs',
        'weightEntries',
        'bodyMeasurements',
        'dashboardPreferences'
      ];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /households/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if inHouse(id);
    }

    match /householdInvites/{code} {
      allow read, create: if signedIn();
    }

    match /appConfig/{id} {
      allow read, create, update: if signedIn();
    }

    match /profileMembers/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || inHouse(resource.data.householdId));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /{col}/{id} {
      allow read: if signedIn() && appCollection(col) && inHouse(resource.data.householdId);
      allow create: if signedIn() && appCollection(col) && inHouse(request.resource.data.householdId);
      allow update: if signedIn() && appCollection(col) && inHouse(resource.data.householdId) && keepOwnerFields();
      allow delete: if signedIn() && appCollection(col) && inHouse(resource.data.householdId);
    }
  }
}
